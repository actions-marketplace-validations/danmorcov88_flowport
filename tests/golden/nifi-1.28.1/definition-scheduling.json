  "findings": [
    {
      "category": "scheduling",
      "details": {
        "expression": "0 0 6 ? * 1",
        "field": "1"
      },
      "location": {
        "id": "a9d02034-01a0-1000-0e1c-82eb12dff166",
        "kind": "PROCESSOR",
        "name": "Cron with numeric weekday",
        "path": "/Scheduling",
        "type": "org.apache.nifi.processors.standard.GenerateFlowFile"
      },
      "message": "Run schedule '0 0 6 ? * 1' uses a number for the day of week ('1'). NiFi 1.x (Quartz) counts 1 as Sunday; NiFi 2.x (Spring) counts 1 as Monday, so the schedule shifts by one day without any error.",
      "rule_id": "NIFI2-CRON-NUMERIC-DAY-OF-WEEK",
      "severity": "MANUAL",
      "sources": [
        "https://issues.apache.org/jira/browse/NIFI-12290",
        "https://cwiki.apache.org/confluence/display/NIFI/Migrating+Deprecated+Components+and+Features+for+2.0.0"
      ],
      "suggestion": "Use day names (SUN, MON, ...) instead of numbers.",
      "title": "Cron expression with a numeric day of week"
    },
    {
      "category": "scheduling",
      "details": {
        "expression": "0 0 12 * * ? 2030"
      },
      "location": {
        "id": "a9d02011-01a0-1000-ad75-2372e7a2d16d",
        "kind": "PROCESSOR",
        "name": "Cron with year field",
        "path": "/Scheduling",
        "type": "org.apache.nifi.processors.standard.GenerateFlowFile"
      },
      "message": "Run schedule '0 0 12 * * ? 2030' has seven fields. NiFi 2.x uses Spring cron expressions, which have no year field, so the component is invalid.",
      "rule_id": "NIFI2-CRON-YEAR-FIELD",
      "severity": "BLOCKER",
      "sources": [
        "https://issues.apache.org/jira/browse/NIFI-12290",
        "https://cwiki.apache.org/confluence/display/NIFI/Migrating+Deprecated+Components+and+Features+for+2.0.0"
      ],
      "suggestion": "Remove the seventh field. Components can no longer be scheduled for a specific year.",
      "title": "Cron expression with a year field"
    },
    {
      "category": "scheduling",
      "details": {},
      "location": {
        "id": "a9d01ff8-01a0-1000-7ffe-aad78f732aca",
        "kind": "PROCESSOR",
        "name": "Event driven",
        "path": "/Scheduling",
        "type": "org.apache.nifi.processors.attributes.UpdateAttribute"
      },
      "message": "UpdateAttribute uses the EVENT_DRIVEN scheduling strategy. NiFi 2.x does not recognize it and fails to start when the flow contains it.",
      "rule_id": "NIFI2-EVENT-DRIVEN",
      "severity": "BLOCKER",
      "sources": [
        "https://issues.apache.org/jira/browse/NIFI-11813",
        "https://cwiki.apache.org/confluence/display/NIFI/Deprecated+Components+and+Features"
      ],
      "suggestion": "Change the scheduling strategy to TIMER_DRIVEN (run schedule 0 sec) before upgrading.",
      "title": "Event-driven scheduling removed in NiFi 2.x"
    }
  ],
